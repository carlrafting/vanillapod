{
  "name": "@carlrafting/vanillapod",
  "version": "0.11.2",
  "exports": "./mod.ts",
  "compilerOptions": {
    "checkJs": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ]
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": [
      "vanillapod.d.ts",
      "src/*.d.ts"
    ]
  },
  "lint": {
    "exclude": [
      "vanillapod.d.ts",
      "src/*.d.ts"
    ]
  },
  "publish": {
    "include": [
      "mod.ts",
      "vanillapod.js",
      "vanillapod.d.ts",
      "src/",
      "readme.md",
      "LICENSE"
    ]
  }
}
