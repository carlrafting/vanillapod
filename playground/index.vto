---
layout: layouts/page.vto
title: Playground
description: Write vanillapod code and see it run, right in your browser.
---

<link rel="stylesheet" href="/playground/vendor/prism.min.css" media="screen">
<link rel="stylesheet" href="/playground/styles.css" media="screen">

<main>
  <vp-playground share example="counter">
  <pre id="hello" data-title="Hello, world">import { render, h1, p } from "vanillapod";

render(
  [
    h1("Hello, vanillapod!"),
    p("Edit the code on the left and watch this change."),
  ],
  document.querySelector("#app"),
);</pre>

  <pre id="counter" data-title="Counter (createStore + bind)">import { bind, button, createStore, p, render } from "vanillapod";

const state = createStore({ count: 0 });

const output = p();
// bind runs now, and again only when state.count is written
bind(state, "count", (count) => {
  output.textContent = `Count: ${count}`;
});

render(
  [
    output,
    button({ onClick: () => state.count++ }, "Increment"),
    button({ onClick: () => state.count-- }, "Decrement"),
    button({ onClick: () => (state.count = 0) }, "Reset"),
  ],
  document.querySelector("#app"),
);</pre>

  <pre id="list" data-title="List (bindList)">import {
  bind,
  bindList,
  button,
  createStore,
  form,
  input,
  li,
  p,
  render,
  ul,
} from "vanillapod";

const state = createStore({ items: [{ id: 1, text: "Try vanillapod" }] });
let nextId = 2;

const list = ul();
bindList(state, "items", {
  parent: list,
  key: (item) => item.id,
  render: (item) =>
    li(
      item.text + " ",
      button({
        onClick: () => {
          state.items = state.items.filter((i) => i.id !== item.id);
        },
      }, "Remove"),
    ),
});

const count = p();
bind(state, "items", (items) => {
  count.textContent = `${items.length} item(s)`;
});

const field = input({ placeholder: "New item", required: true });
const add = form(
  {
    onSubmit(event) {
      event.preventDefault();
      // assign a new array: bind() re-runs when the "items" key is written
      state.items = [...state.items, { id: nextId++, text: field.value }];
      field.value = "";
    },
  },
  field,
  button({ type: "submit" }, "Add"),
);

render([add, count, list], document.querySelector("#app"));</pre>

  <pre id="console" data-title="Console output">import { render, button } from "vanillapod";

render(
  [
    button({
      onClick: (event) => console.log("clicked", event.type, Date.now()),
    }, "Log a click"),
  ],
  document.querySelector("#app"),
);

console.warn("console.warn and errors show up below the preview");</pre>
  </vp-playground>

  <!-- The markup <vp-playground> clones for its own UI. Elements marked
       data-part are looked up by name; data-labelledby names the part whose
       heading labels the element (ids are made unique per instance). -->
  <template id="vp-playground-template">
    <div class="pg-toolbar" role="toolbar" aria-label="Playground controls">
      <label>Example <select data-part="example"></select></label>
      <button type="button" data-part="run">Run <kbd>Ctrl</kbd>+<kbd>Enter</kbd></button>
      <label class="pg-auto">
        <input type="checkbox" data-part="auto" checked> Run as I type
      </label>
      <button type="button" data-part="share" hidden>Copy share link</button>
      <button type="button" data-part="reset">Reset</button>
      <span class="pg-status" data-part="status" role="status" aria-live="polite"></span>
    </div>
    <div class="pg-panes">
      <section class="pg-pane" data-labelledby="code-heading">
        <h2 data-part="code-heading">Code</h2>
        <pre class="pg-editor language-javascript" data-part="editor" role="textbox"
          autocapitalize="off" autocorrect="off"
          aria-multiline="true" aria-label="Code editor" tabindex="0"></pre>
        <p class="pg-hint">
          Import from <code>"vanillapod"</code>. Render into <code>#app</code>.
          <kbd>Tab</kbd> indents, <kbd>Esc</kbd> then <kbd>Tab</kbd> moves focus.
        </p>
      </section>
      <section class="pg-pane" data-labelledby="preview-heading">
        <h2 data-part="preview-heading">Preview</h2>
        <iframe class="pg-preview" data-part="preview" title="Playground preview"
          sandbox="allow-scripts allow-forms"></iframe>
        <h2 data-part="console-heading">Console</h2>
        <ol class="pg-console" data-part="console" data-labelledby="console-heading"
          aria-live="polite"></ol>
      </section>
    </div>
  </template>
  <noscript>The playground requires JavaScript to run code.</noscript>
</main>

<script data-manual src="/playground/vendor/prism-core.min.js"></script>
<script src="/playground/vendor/prism-clike.min.js"></script>
<script src="/playground/vendor/prism-javascript.min.js"></script>
<script type="module" src="/playground/playground.js"></script>
