---
title: Validation Summary
description: Collects invalid fields into a list of links above the form on submit, moves focus to the summary and marks fields with aria-invalid. Relies on native constraint validation.
tags: [forms, accessibility, javascript]
---

<link rel="stylesheet" href="./styles.css" media="screen">

<form class="validated-form" novalidate>
  <div class="validation-summary" tabindex="-1" hidden>
    <h3>Please fix the following</h3>
    <ul></ul>
  </div>
  <p>
    <label for="vs-email">Email</label>
    <input id="vs-email" type="email" name="email" required>
  </p>
  <p>
    <label for="vs-name">Name</label>
    <input id="vs-name" type="text" name="name" required minlength="2">
  </p>
  <button>Submit</button>
</form>

<script>
  for (const form of document.querySelectorAll(".validated-form")) {
    const summary = form.querySelector(".validation-summary");
    const list = summary.querySelector("ul");
    form.addEventListener("submit", (event) => {
      list.replaceChildren();
      const invalid = [...form.elements].filter((el) => el.willValidate && !el.checkValidity());
      for (const el of form.elements) el.removeAttribute("aria-invalid");
      if (invalid.length === 0) return;
      event.preventDefault();
      for (const el of invalid) {
        el.setAttribute("aria-invalid", "true");
        const label = form.querySelector(`label[for="${el.id}"]`)?.textContent ?? el.name;
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `#${el.id}`;
        link.textContent = `${label}: ${el.validationMessage}`;
        link.addEventListener("click", (e) => {
          e.preventDefault();
          el.focus();
        });
        item.append(link);
        list.append(item);
      }
      summary.hidden = false;
      summary.focus();
    });
  }
</script>
