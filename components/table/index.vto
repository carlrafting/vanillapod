---
title: Table
description: Base layout styles apply to every table element. Add the table class for borders, zebra rows and sortable headers, and wrap the table in a focusable container so keyboard users can scroll it horizontally on small viewports.
tags: [data, accessibility, javascript]
---

<link rel="stylesheet" href="./styles.css" media="screen">

<h2>Standard table</h2>

<table>
  <caption>Browser support</caption>
  <thead>
    <tr>
      <th scope="col">Feature</th>
      <th scope="col">Chrome</th>
      <th scope="col">Firefox</th>
      <th scope="col">Safari</th>
    </tr>
  </thead>
  <tbody>
    <tr><th scope="row">Popover</th><td>114</td><td>125</td><td>17</td></tr>
    <tr><th scope="row">@scope</th><td>118</td><td>146</td><td>17.4</td></tr>
    <tr><th scope="row">dialog</th><td>37</td><td>98</td><td>15.4</td></tr>
  </tbody>
</table>

<h2>Sortable table</h2>

<div class="table-wrapper" tabindex="0" role="region" aria-label="Components">
  <table class="table">
    <caption>Components</caption>
    <thead>
      <tr>
        <th scope="col" aria-sort="none"><button type="button">Name</button></th>
        <th scope="col" aria-sort="none"><button type="button">Type</button></th>
      </tr>
    </thead>
    <tbody>
      <tr><td>Tabs</td><td>Navigation</td></tr>
      <tr><td>Alert</td><td>Feedback</td></tr>
      <tr><td>Card</td><td>Layout</td></tr>
    </tbody>
  </table>
</div>

<script>
  for (const table of document.querySelectorAll(".table")) {
    const headers = [...table.querySelectorAll("th[aria-sort]")];
    headers.forEach((th, index) => {
      th.querySelector("button").addEventListener("click", () => {
        const asc = th.getAttribute("aria-sort") !== "ascending";
        for (const h of headers) h.setAttribute("aria-sort", "none");
        th.setAttribute("aria-sort", asc ? "ascending" : "descending");
        const body = table.tBodies[0];
        const rows = [...body.rows].sort((a, b) =>
          a.cells[index].textContent.localeCompare(b.cells[index].textContent, undefined, { numeric: true }) * (asc ? 1 : -1)
        );
        body.append(...rows);
      });
    });
  }
</script>
