---
title: Toast
description: Transient notifications announced through an aria-live region. Call showToast(message, { variant, timeout }) to add one, it removes itself after a timeout, which pauses while hovered. Variants are info, success, warning and danger (or error). Configure animation with data-animation="slide|fade|none" on the region or a single toast, and tune it with --toast-duration, --toast-easing and --toast-offset.
tags: [feedback, accessibility, javascript]
---

<link rel="stylesheet" href="./styles.css" media="screen">

<p>
  <label for="toast-animation">Animation</label>
  <select id="toast-animation">
    <option value="slide">Slide</option>
    <option value="fade">Fade</option>
    <option value="none">None</option>
  </select>
</p>

<div class="toast-demo">
  <button type="button" data-variant="info">Info toast</button>
  <button type="button" data-variant="success">Success toast</button>
  <button type="button" data-variant="warning">Warning toast</button>
  <button type="button" data-variant="danger">Danger toast</button>
</div>

<div class="toasts" role="status" aria-live="polite" data-animation="slide"></div>

<script>
  function showToast(message, { variant = "info", timeout = 4000 } = {}) {
    const region = document.querySelector(".toasts");
    const toast = document.createElement("div");
    toast.className = "toast";
    toast.dataset.variant = variant;
    toast.textContent = message;
    region.append(toast);

    const remove = () => {
      if (toast.dataset.leaving !== undefined) return;
      toast.dataset.leaving = "";
      const duration = Math.max(
        ...getComputedStyle(toast).transitionDuration.split(",").map((value) => parseFloat(value) * (value.includes("ms") ? 1 : 1000)),
      );
      if (!duration) return toast.remove();
      toast.addEventListener("transitionend", () => toast.remove(), { once: true });
      setTimeout(() => toast.remove(), duration + 50);
    };

    let timer;
    const start = () => (timer = setTimeout(remove, timeout));
    const pause = () => clearTimeout(timer);
    toast.addEventListener("mouseenter", pause);
    toast.addEventListener("mouseleave", start);
    start();
  }

  const messages = {
    info: "A new version is available",
    success: "Changes saved",
    warning: "Your session expires soon",
    danger: "Could not save changes",
  };
  for (const button of document.querySelectorAll(".toast-demo button")) {
    button.addEventListener("click", () => {
      showToast(messages[button.dataset.variant], { variant: button.dataset.variant });
    });
  }
  document.getElementById("toast-animation").addEventListener("change", (event) => {
    document.querySelector(".toasts").dataset.animation = event.target.value;
  });
</script>
