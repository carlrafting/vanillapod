{
  "name": "vanillapod",
  "version": "0.11.2",
  "type": "module",
  "repository": "https://github.com/carlrafting/vanillapod.git",
  "author": {
    "name": "Carl Räfting",
    "email": "mail@carlrafting.com",
    "url": "https://carlrafting.com"
  },
  "license": "MIT",
  "devDependencies": {},
  "scripts": {
    "test": "node --test-reporter=spec --test",
    "test:watch": "npm t -- --watch",
    "types": "node scripts/clean-types.js && npx --yes --package typescript@6.0.3 tsc -p tsconfig.types.json",
    "preversion": "npm test",
    "version": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "workspaces": [
    "./examples/*",
    "sandbox/reactive",
    "sandbox/html",
    "sandbox/dom",
    "sandbox/standard",
    "sandbox/hyper",
    "sandbox/ssr"
  ],
  "main": "./vanillapod.js",
  "module": "./vanillapod.js",
  "types": "./vanillapod.d.ts",
  "exports": {
    ".": {
      "types": "./vanillapod.d.ts",
      "default": "./vanillapod.js"
    },
    "./state": {
      "types": "./src/state.d.ts",
      "default": "./src/state.js"
    },
    "./dom": {
      "types": "./src/dom.d.ts",
      "default": "./src/dom.js"
    },
    "./error": {
      "types": "./src/error.d.ts",
      "default": "./src/error.js"
    },
    "./debug": {
      "types": "./src/debug.d.ts",
      "default": "./src/debug.js"
    },
    "./utils": {
      "types": "./src/utils.d.ts",
      "default": "./src/utils.js"
    }
  }
}
